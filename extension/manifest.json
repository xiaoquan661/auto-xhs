{
  "manifest_version": 3,
  "name": "XHS / RedNote Bridge",
  "version": "1.3.3",
  "description": "小红书与 RedNote 多账号通用 Bridge - 每个 Chrome Profile 连接一个平台账号槽位",
  "permissions": [
    "tabs",
    "cookies",
    "scripting",
    "alarms",
    "debugger",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://*.xiaohongshu.com/*",
    "https://xiaohongshu.com/*",
    "https://*.rednote.com/*",
    "https://rednote.com/*",
    "ws://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "XHS Bridge"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.xiaohongshu.com/*",
        "https://xiaohongshu.com/*",
        "https://creator.xiaohongshu.com/*",
        "https://www.rednote.com/*",
        "https://rednote.com/*",
        "https://creator.rednote.com/*"
      ],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.xiaohongshu.com/*",
        "https://xiaohongshu.com/*",
        "https://creator.xiaohongshu.com/*",
        "https://www.rednote.com/*",
        "https://rednote.com/*",
        "https://creator.rednote.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
